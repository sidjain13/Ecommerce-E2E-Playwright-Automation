{
  "name": "ecommerceproject",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "login:test": "npx playwright test tests/specs/login.spec.ts",
    "register:test": "npx playwright test tests/specs/register.spec.ts",
    "allure:clean": "rimraf allure-results",
    "allure:generate": "node -e \"const d=new Date();const ts=d.getFullYear()+('0'+(d.getMonth()+1)).slice(-2)+('0'+d.getDate()).slice(-2)+'-'+('0'+d.getHours()).slice(-2)+('0'+d.getMinutes()).slice(-2)+('0'+d.getSeconds()).slice(-2);require('child_process').execSync(`allure generate allure-results --clean -o reports/allure-report-${ts}`,{stdio:'inherit'})\"",
    "allure:open": "node -e \"const fs=require('fs');const dirs=fs.readdirSync('reports').filter(d=>d.startsWith('allure-report')).sort();require('child_process').execSync(`allure open reports/${dirs[dirs.length-1]}`,{stdio:'inherit'})\"",
    "report": "npm run allure:generate && npm run allure:clean && npm run allure:open",
    "test:all": "npm run allure:clean & npx playwright test & npm run allure:generate & npm run allure:open "
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.2"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "rimraf": "^6.1.2",
    "xlsx": "^0.18.5"
  }
}
